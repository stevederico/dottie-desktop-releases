<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Entitlements for nested executables inside Dottie.app:
         Resources/node/bin/node (V8 JIT for the gateway).
         Hardened-runtime restrictions are per-binary; the parent .app's
         entitlements don't propagate to spawned children. -->

    <!-- V8 JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- V8 maps writable+executable pages for generated code -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Native .node addons / dylibs loaded by Node -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Optional DYLD_* for native addon resolution -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- V8 marks pages executable after writing JIT code -->
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
</dict>
</plist>
